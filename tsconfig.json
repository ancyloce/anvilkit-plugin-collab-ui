{
	"extends": "@anvilkit/typescript-config/react-library-bundler.json",
	"compilerOptions": {
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"outDir": "dist",
		"rootDir": "src",
		"paths": {
			"@anvilkit/collab-ui": ["src"],
			"@anvilkit/collab-ui/*": ["src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": [
		"node_modules",
		"dist",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx",
		"src/**/__tests__/**"
	]
}
